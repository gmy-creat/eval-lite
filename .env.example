# 复制这个文件成 .env，然后填上真实的值。
#
#   Copy-Item .env.example .env
#
# .env 已经被 .gitignore 排除了，不会提交上去。
# 而 .env.example 是要提交的 —— 别人 clone 之后照着它就知道要配什么。

# 模型服务的地址和密钥
EVAL_API_BASE_URL=https://example.invalid/api
EVAL_API_KEY=在这里填你的密钥

# 并发数：同时最多发几个请求
EVAL_CONCURRENCY=8

# 日志级别：DEBUG / INFO / WARNING / ERROR
EVAL_LOG_LEVEL=INFO
